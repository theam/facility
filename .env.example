# Facility platform — development environment
# Copy to .env and adjust. NEVER commit .env.

# --- Core ---
DATABASE_URL=postgres://facility:facility@localhost:5461/facility
# 32 bytes, base64. Generate: openssl rand -base64 32
SECRET_MASTER_KEY=
PORT=4400
PUBLIC_URL=http://localhost:4400
WEB_URL=http://localhost:3400
# Untrusted preview applications use a browser origin distinct from Facility.
# *.localhost resolves to loopback in modern browsers without /etc/hosts.
FACILITY_PREVIEW_URL=http://preview.localhost:4400
# Advanced reverse-proxy boundary. When set, only an exact proxy-injected value
# may select preview routes without using FACILITY_PREVIEW_URL as Host. The AWS
# module generates and wires this automatically; leave it blank locally.
FACILITY_PREVIEW_SURFACE_TOKEN=
# Extra hostnames allowed to reach the dev server cross-origin (tunnel, LAN).
# Comma-separated, no scheme. Development only.
FACILITY_DEV_ORIGINS=
LOG_LEVEL=info

# Relaxes local rate limits only. It never exposes an authentication bypass.
FACILITY_INSECURE_DEV=1

# --- Sandboxes ---
# Driver the seeded default sandbox profile uses; must match the deployment.
# "docker" for local/self-host, "vercel" for managed Sandboxes, or "aws" for
# the CodeBuild/Fargate development provider. `facility doctor` fails if no
# profile matches this driver.
FACILITY_SANDBOX_DRIVER=docker
# Image the seeded default sandbox profile uses to run platform-lane agents
# (Claude Code, Codex) on the docker driver. Its entrypoint must be the Facility
# runner — build it with `docker build -f runner/Dockerfile -t facility-runner:dev .`. In the
# Vercel this is a project-scoped VCR repository/tag; AWS fixes it on CodeBuild.
FACILITY_RUNNER_IMAGE=facility-runner:dev
# URLs as resolved from inside a sandbox, not necessarily browser-facing URLs.
SANDBOX_API_URL=http://host.docker.internal:4400
SANDBOX_GATEWAY_URL=http://host.docker.internal:4410
# Docker network for restricted-egress sandbox profiles (compose: facility_default).
FACILITY_SANDBOX_DOCKER_NETWORK=
# Vercel Sandbox credentials. Prefer the short-lived workload OIDC token when
# the control plane runs on Vercel; an external control plane uses a scoped PAT.
VERCEL_TOKEN=
VERCEL_OIDC_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# --- Object storage (MinIO in dev; any S3-compatible in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=facility
S3_SECRET_KEY=facility-dev-secret
S3_BUCKET=facility
AWS_REGION=us-east-1

# --- Human login: direct GitHub App OAuth or commercial OIDC broker ---
AUTH_IDENTITY_PROVIDER=github
AUTH_CALLBACK_URL=http://localhost:3400/api/auth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Optional GitHub organization login. Blank preserves invitation + installation checks only.
GITHUB_OAUTH_ALLOWED_ORGANIZATION=
# In oidc mode, set the commercial broker and the instance-bound client values.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
FACILITY_INSTANCE_ID=

# --- Per-instance MCP OAuth authorization server ---
# OAuth browser endpoints use the web origin so host-only interaction, login,
# and callback cookies remain on one origin. The web app proxies them to the API.
FACILITY_OAUTH_ISSUER=http://localhost:3400
# Private ES256 JWK set; `pnpm dev` generates a persistent local value when blank.
FACILITY_OAUTH_JWKS=
# An origin-only MCP_PUBLIC_URL remains accepted and canonicalizes to /mcp.
MCP_PUBLIC_URL=http://localhost:4420
MCP_AUTHORIZATION_SERVER=http://localhost:3400
# Comma-separated Host/Origin authorities accepted by a remote MCP bind.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# Exact number of trusted right-most reverse-proxy hops for client rate limits.
# Keep 0 unless MCP is behind a proxy you operate; forwarded headers are ignored.
MCP_TRUST_PROXY_HOPS=0

# --- LLM gateway (provider credentials are normally stored sealed via the API;
#     these env fallbacks exist for local development only) ---
GATEWAY_PORT=4410
DEV_ANTHROPIC_API_KEY=
DEV_OPENAI_API_KEY=

# --- GitHub App installation (repo automation) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
# Self-host fallback for private clones when no App installation token is available.
GITHUB_CLONE_TOKEN=
