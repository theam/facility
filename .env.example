# Facility 0.12 local development. Copy to .env; never commit .env.
DATABASE_URL=postgres://facility:facility@localhost:5461/facility
# Generate with: openssl rand -base64 32
SECRET_MASTER_KEY=
PORT=4400
PUBLIC_URL=http://localhost:4400
WEB_URL=http://localhost:3400
FACILITY_PREVIEW_URL=http://preview.localhost:4400
FACILITY_PREVIEW_SURFACE_TOKEN=
FACILITY_DEV_ORIGINS=
LOG_LEVEL=info
FACILITY_INSECURE_DEV=1

# Persistent workspace runtime: docker locally, vercel in managed deployments.
FACILITY_WORKSPACE_DRIVER=docker
FACILITY_WORKSPACE_IMAGE=facility-runner:dev
VERCEL_TOKEN=
VERCEL_OIDC_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Human authentication.
AUTH_IDENTITY_PROVIDER=github
AUTH_CALLBACK_URL=http://localhost:3400/api/auth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_ALLOWED_ORGANIZATION=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
FACILITY_INSTANCE_ID=

# Embedded MCP and its optional browser authorization server.
FACILITY_OAUTH_ISSUER=http://localhost:3400
FACILITY_OAUTH_JWKS=
MCP_PUBLIC_URL=http://localhost:4400/mcp

# GitHub App authentication and full installation capability.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
# Local-only fallback when no installation token can be minted.
GITHUB_CLONE_TOKEN=
