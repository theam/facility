{
  "name": "@facility/api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts src/dev.ts src/start.ts src/worker.ts src/openapi.ts --format esm --dts",
    "build:runtime": "tsup src/index.ts src/dev.ts src/start.ts src/worker.ts src/openapi.ts --format esm",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --fileParallelism=false",
    "test:e2e-sandbox": "vitest run --fileParallelism=false test/sandbox.e2e.test.ts",
    "dev": "tsx watch src/dev.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/start.js",
    "worker": "tsx src/worker.ts",
    "openapi": "tsx src/openapi.ts && pnpm --filter @facility/sdk generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.5",
    "@aws-sdk/client-cloudwatch-logs": "3.1079.0",
    "@aws-sdk/client-codebuild": "3.1079.0",
    "@aws-sdk/client-ecs": "3.1079.0",
    "@facility/core": "workspace:*",
    "@facility/db": "workspace:*",
    "@facility/harness": "workspace:*",
    "@facility/run-objective": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/middie": "^9.3.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@octokit/app": "^16.1.2",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "@vercel/sandbox": "3.0.0",
    "cron-parser": "4.9.0",
    "dockerode": "^5.0.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.12.1",
    "fastify-type-provider-zod": "^6.1.0",
    "jose": "^6.2.3",
    "oidc-provider": "^9.8.2",
    "pg-boss": "^10.3.2",
    "pino": "^10.1.0",
    "postgres": "^3.4.7",
    "tldts": "7.4.10",
    "undici": "^7.29.0",
    "uuidv7": "^1.0.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/node": "^24.10.1",
    "openapi-typescript": "^7.10.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "vitest": "^4.0.15"
  }
}
