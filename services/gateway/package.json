{
  "name": "@facility/gateway",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts src/dev.ts src/start.ts --format esm --dts",
    "build:runtime": "tsup src/index.ts src/dev.ts src/start.ts --format esm",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/dev.ts",
    "start": "node dist/start.js"
  },
  "dependencies": {
    "@facility/core": "workspace:*",
    "@facility/db": "workspace:*",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.12.1",
    "pino": "^10.1.0",
    "postgres": "^3.4.7",
    "uuidv7": "^1.0.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "vitest": "^4.0.15"
  }
}
