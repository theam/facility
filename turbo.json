{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["FACILITY_GITHUB_CREDENTIALS", "FACILITY_PREVIEW_GATEWAY_TOKEN"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "env": ["DATABASE_URL", "FACILITY_DEV_ORIGINS"],
      "persistent": true
    },
    "dev:worker": {
      "cache": false,
      "env": ["DATABASE_URL"],
      "persistent": true
    }
  }
}
