{
  "name": "@facility/mcp",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "bin": {
    "facility-mcp": "dist/bin/facility-mcp.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts src/bin/facility-mcp.ts --format esm --dts",
    "build:runtime": "tsup src/index.ts src/bin/facility-mcp.ts --format esm",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@facility/core": "workspace:*",
    "@facility/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
